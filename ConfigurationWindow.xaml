<Window x:Class="SNAPPY.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SNAPPY - Outdoor Station Configuration"
        Width="1180"
        Height="760"
        Background="#101318"
        Foreground="#F4F7FA"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="OUTDOOR STATION CONFIGURATION" FontSize="23" FontWeight="Bold" />
            <TextBlock Text="Maximum 9 stations • settings are saved locally on this PC" Foreground="#7F8B99" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#171C23" CornerRadius="12" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="#" Foreground="#7F8B99" Margin="5" />
                <TextBlock Grid.Column="1" Text="NAME" Foreground="#7F8B99" Margin="5" />
                <TextBlock Grid.Column="2" Text="IP ADDRESS" Foreground="#7F8B99" Margin="5" />
                <TextBlock Grid.Column="3" Text="HTTP" Foreground="#7F8B99" Margin="5" />
                <TextBlock Grid.Column="4" Text="RTSP" Foreground="#7F8B99" Margin="5" />
                <TextBlock Grid.Column="5" Text="USERNAME" Foreground="#7F8B99" Margin="5" />
                <TextBlock Grid.Column="6" Text="PASSWORD" Foreground="#7F8B99" Margin="5" />
                <TextBlock Grid.Column="7" Text="STATUS" Foreground="#7F8B99" Margin="5" />

                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="StationsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#202832" CornerRadius="6" Margin="0,4" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" VerticalAlignment="Center" Margin="5" />
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="3" />
                                        <TextBox Grid.Column="2" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Margin="3" />
                                        <TextBox Grid.Column="3" Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" Margin="3" />
                                        <TextBox Grid.Column="4" Text="{Binding RtspPort, UpdateSourceTrigger=PropertyChanged}" Margin="3" />
                                        <TextBox Grid.Column="5" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="3" />
                                        <PasswordBox Grid.Column="6" x:Name="PasswordBox" Margin="3" PasswordChanged="PasswordBox_PasswordChanged" Tag="{Binding}" />
                                        <TextBlock Grid.Column="7" x:Name="StatusText" Text="NOT TESTED" Foreground="#7F8B99" VerticalAlignment="Center" Margin="8,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FilePathText" VerticalAlignment="Center" Foreground="#6F7B89" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="TEST ALL" Click="TestAllButton_Click" Padding="18,10" Margin="0,0,8,0" Background="#263241" Foreground="White" BorderThickness="0" />
                <Button Content="SAVE CONFIGURATION" Click="SaveButton_Click" Padding="18,10" Background="#1F9D61" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
