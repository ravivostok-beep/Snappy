<Window x:Class="SNAPPY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SNAPPY - Hikvision Indoor Station"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        Background="#101418"
        Foreground="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#181E24"/>
            <Setter Property="BorderBrush" Value="#2A333C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#202830"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A4650"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,5,0,5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="#2C3741"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background"
                                        Value="#35434F"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity"
                                        Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#087F5B"/>
            <Setter Property="BorderBrush" Value="#0AA06F"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="#099B70"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#8E3030"/>
            <Setter Property="BorderBrush" Value="#B54040"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="#A83A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UnlockButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#B56A00"/>
            <Setter Property="BorderBrush" Value="#D88A00"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="55"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="#D17B00"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#151B20"
                BorderBrush="#2A333C"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">

                    <TextBlock Text="SNAPPY"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>

                    <TextBlock Text="Hikvision Indoor / Outdoor Station"
                               FontSize="12"
                               Foreground="#8996A3"
                               Margin="1,2,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="STATUS"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#73808C"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <Border Background="#202830"
                            CornerRadius="5"
                            Padding="14,6">

                        <TextBlock x:Name="StatusText"
                                   Text="STARTING"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#57D6A3"/>

                    </Border>

                </StackPanel>

            </Grid>

        </Border>


        <!-- MAIN AREA -->
        <Grid Grid.Row="1"
              Margin="0,15,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>


            <!-- OUTDOOR STATIONS -->
            <Border Grid.Column="0"
                    Style="{StaticResource PanelStyle}"
                    Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="OUTDOOR STATIONS"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#DDE4EA"
                               Margin="0,0,0,12"/>

                    <ListBox x:Name="OutdoorList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             SelectionChanged="OutdoorList_SelectionChanged">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#202830"
                                        BorderBrush="#303B45"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10"
                                        Margin="0,3">

                                    <StackPanel>

                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding IpAddress}"
                                                   FontSize="11"
                                                   Foreground="#82909D"
                                                   Margin="0,3,0,0"/>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <Button Grid.Row="2"
                            x:Name="OutdoorConfigButton"
                            Content="⚙  OUTDOOR CONFIGURATION"
                            Click="OutdoorConfigButton_Click"
                            Height="42"
                            Margin="0,12,0,0"
                            Style="{StaticResource ActionButtonStyle}"/>

                </Grid>

            </Border>


            <!-- LIVE VIDEO -->
            <Border Grid.Column="1"
                    Style="{StaticResource PanelStyle}"
                    Margin="5,0,5,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock Text="LIVE VIDEO"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#DDE4EA"/>

                        <TextBlock x:Name="SelectedStationText"
                                   Text="No station selected"
                                   FontSize="12"
                                   Foreground="#82909D"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <Border Grid.Row="1"
                            Background="#090C0F"
                            BorderBrush="#28313A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,14,0,14">

                        <Grid>

                            <TextBlock x:Name="LiveVideoText"
                                       Text="LIVE VIDEO"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#4D5964"
                                       TextAlignment="Center"/>

                        </Grid>

                    </Border>


                    <TextBlock Grid.Row="2"
                               Text="Hikvision video preview area"
                               FontSize="11"
                               Foreground="#66727D"
                               HorizontalAlignment="Center"/>

                </Grid>

            </Border>


            <!-- CONTROL PANEL -->
            <Border Grid.Column="2"
                    Style="{StaticResource PanelStyle}"
                    Margin="10,0,0,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="CALL CONTROL"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#DDE4EA"
                                   Margin="0,0,0,8"/>


                        <Button x:Name="AnswerButton"
                                Content="✓  ANSWER"
                                Click="AnswerButton_Click"
                                Height="48"
                                Style="{StaticResource PrimaryButtonStyle}"/>


                        <Button x:Name="RejectButton"
                                Content="✕  REJECT"
                                Click="RejectButton_Click"
                                Height="48"
                                Style="{StaticResource DangerButtonStyle}"/>


                        <Button x:Name="TalkButton"
                                Content="START TWO-WAY TALK"
                                Click="TalkButton_Click"
                                Height="48"
                                Margin="0,15,0,5"
                                Style="{StaticResource ActionButtonStyle}"/>


                        <Border Height="1"
                                Background="#2A333C"
                                Margin="0,15,0,15"/>


                        <TextBlock Text="DOOR CONTROL"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#DDE4EA"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="DS-K1T502DBFWX-C"
                                   FontSize="11"
                                   Foreground="#7D8A96"
                                   Margin="0,0,0,8"/>


                        <!-- REAL PHYSICAL LOCK CONTROL -->
                        <Button x:Name="UnlockDoorButton"
                                Content="🔓  UNLOCK DOOR"
                                Click="UnlockDoorButton_Click"
                                Style="{StaticResource UnlockButtonStyle}"/>


                        <TextBlock Text="Door 1 / Lock Relay 1"
                                   FontSize="10"
                                   Foreground="#687580"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0"/>


                        <Border Height="1"
                                Background="#2A333C"
                                Margin="0,18,0,15"/>


                        <TextBlock Text="SELECTED DEVICE"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#73808C"/>

                        <TextBlock x:Name="SelectedStationInfoText"
                                   Text="No device selected"
                                   FontSize="12"
                                   Foreground="#AAB5BE"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>


        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="#151B20"
                BorderBrush="#2A333C"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,0">

            <Grid>

                <TextBlock x:Name="FooterText"
                           Text="SNAPPY starting..."
                           FontSize="11"
                           Foreground="#7D8994"
                           VerticalAlignment="Center"/>

                <TextBlock Text="SNAPPY VMS"
                           FontSize="11"
                           Foreground="#59646E"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>
