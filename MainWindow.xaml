<Window x:Class="SNAPPY.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
 Title="SNAPPY - Hikvision Indoor Station"
 Width="1200" Height="760"
 Background="#111827" Foreground="White"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <DockPanel Grid.Row="0" Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Left">
    <TextBlock Text="SNAPPY" FontSize="30" FontWeight="Bold"/>
    <TextBlock Text="Hikvision Indoor Station" Foreground="#9CA3AF"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right">
    <TextBlock x:Name="DeviceText" FontSize="15"
               HorizontalAlignment="Right"/>
    <TextBlock x:Name="StatusText" Text="Ready"
               Foreground="#9CA3AF"
               HorizontalAlignment="Right"/>
   </StackPanel>
  </DockPanel>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="330"/>
   </Grid.ColumnDefinitions>

   <Border Grid.Column="0" Background="#030712"
           CornerRadius="12" BorderBrush="#374151"
           BorderThickness="1" Margin="0,0,14,0">
    <Grid>
     <vlc:VideoView x:Name="VideoView"/>
     <Border VerticalAlignment="Top"
             HorizontalAlignment="Left"
             Margin="14" Background="#B0000000"
             CornerRadius="6" Padding="10,6">
      <TextBlock Text="LIVE VIDEO" FontWeight="Bold"/>
     </Border>
    </Grid>
   </Border>

   <Border Grid.Column="1" Background="#1F2937"
           CornerRadius="12" Padding="18">
    <StackPanel>
     <TextBlock Text="CALL CONTROL"
                FontSize="18" FontWeight="Bold"/>
     <TextBlock x:Name="CallStateText"
                Text="No active call"
                Margin="0,10,0,18"/>

     <Button Content="ANSWER" Click="AnswerButton_Click"
             Height="48" Margin="0,0,0,10"
             Background="#166534"
             Foreground="White" FontWeight="Bold"/>
     <Button Content="REJECT" Click="RejectButton_Click"
             Height="44" Margin="0,0,0,10"
             Background="#991B1B" Foreground="White"/>
     <Button Content="HANG UP" Click="HangupButton_Click"
             Height="44" Margin="0,0,0,18"/>
     <Button Content="UNLOCK DOOR" Click="UnlockButton_Click"
             Height="50"
             Background="#92400E"
             Foreground="White" FontWeight="Bold"/>

     <Separator Margin="0,20"/>
     <TextBlock Text="Hikvision Mapping"
                FontSize="16" FontWeight="Bold"/>
     <TextBlock x:Name="MappingText"
                TextWrapping="Wrap"
                Foreground="#9CA3AF"
                Margin="0,8,0,0"/>
    </StackPanel>
   </Border>
  </Grid>

  <TextBlock Grid.Row="2" x:Name="FooterText"
             Foreground="#6B7280"
             Margin="4,14,0,0"/>
 </Grid>
</Window>
