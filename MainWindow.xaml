<Window x:Class="SNAPPY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SNAPPY - Hikvision Indoor Station"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#111111"
        Loaded="Window_Loaded">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="SNAPPY"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Hikvision Indoor Station Client"
                           FontSize="14"
                           Foreground="#AAAAAA"/>
            </StackPanel>

            <Border DockPanel.Dock="Right"
                    Padding="12,7"
                    Background="#202020"
                    CornerRadius="6">
                <TextBlock x:Name="StatusText"
                           Text="READY"
                           Foreground="#7CFC00"
                           FontWeight="Bold"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,14,0"
                    Background="Black"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <TextBlock Text="LIVE VIDEO"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#777777"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Hikvision RTSP / SDK player will be connected here"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,75,0,0"
                               Foreground="#555555"
                               FontSize="12"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#1B1B1B"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="OUTDOOR STATIONS"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <ListBox x:Name="OutdoorList"
                             Grid.Row="1"
                             Margin="0,12,0,12"
                             Background="#151515"
                             BorderThickness="0"
                             Foreground="White"/>

                    <StackPanel Grid.Row="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AnswerButton"
                                    Grid.Column="0"
                                    Content="ANSWER"
                                    Margin="0,0,5,0"
                                    Height="42"
                                    Click="AnswerButton_Click"/>
                            <Button x:Name="RejectButton"
                                    Grid.Column="1"
                                    Content="REJECT"
                                    Margin="5,0,0,0"
                                    Height="42"
                                    Click="RejectButton_Click"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="Unlock1Button"
                                    Grid.Column="0"
                                    Content="UNLOCK 1"
                                    Margin="0,0,5,0"
                                    Height="42"
                                    Click="Unlock1Button_Click"/>
                            <Button x:Name="Unlock2Button"
                                    Grid.Column="1"
                                    Content="UNLOCK 2"
                                    Margin="5,0,0,0"
                                    Height="42"
                                    Click="Unlock2Button_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="4" Background="#1B1B1B">
            <StatusBarItem>
                <TextBlock x:Name="FooterText"
                           Text="SNAPPY is ready."
                           Foreground="#BBBBBB"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
