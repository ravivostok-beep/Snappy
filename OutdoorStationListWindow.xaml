```xml
<Window x:Class="SNAPPY.OutdoorStationListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SNAPPY - Outdoor Stations"
        Width="900"
        Height="600"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#111111"
        Foreground="White">

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <DockPanel Grid.Row="0">

            <StackPanel DockPanel.Dock="Left">

                <TextBlock Text="OUTDOOR STATIONS"
                           FontSize="25"
                           FontWeight="Bold"/>

                <TextBlock Text="Manage Hikvision outdoor stations"
                           Foreground="#999999"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Content="ADD STATION"
                    Width="130"
                    Height="40"
                    Click="AddButton_Click"/>

        </DockPanel>


        <!-- LIST -->

        <ListBox x:Name="StationList"
                 Grid.Row="2"
                 Background="#181818"
                 BorderBrush="#333333"
                 Foreground="White"
                 SelectionChanged="StationList_SelectionChanged">

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <Border Padding="12"
                            Margin="5"
                            Background="#222222"
                            BorderBrush="#333333"
                            BorderThickness="1">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding IpAddress}"
                                           Foreground="#AAAAAA"
                                           Margin="0,4,0,0"/>

                                <TextBlock Text="{Binding Description}"
                                           Foreground="#777777"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Enabled}"
                                       Foreground="#7CFC00"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>


        <!-- BOTTOM -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="EDIT"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="EditButton_Click"/>

            <Button Content="DELETE"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="DeleteButton_Click"/>

            <Button Content="CLOSE"
                    Width="100"
                    Height="40"
                    Click="CloseButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
```
